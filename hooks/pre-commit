#!/bin/sh
#
# agent-logbook pre-commit hook.
#
# Install:
#   cp hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
#
# The hook runs `logbook check` against the working tree. Because R5 compares
# journal files with their committed versions, it catches a rewrite of history
# before that rewrite becomes a commit.

if [ -x "./node_modules/.bin/logbook" ]; then
  LOGBOOK="./node_modules/.bin/logbook"
elif command -v logbook >/dev/null 2>&1; then
  LOGBOOK="logbook"
else
  # Fail closed, but say what is actually wrong: a missing checker is not the
  # same thing as a logbook that failed its rules.
  echo "Commit stopped: agent-logbook is not installed, so the logbook cannot be checked."
  echo "Install it with 'npm install --save-dev agent-logbook', or delete .git/hooks/pre-commit."
  exit 1
fi

if ! $LOGBOOK check; then
  echo
  echo "Commit stopped: the logbook does not pass its own rules."
  echo "Fix the problems above, or commit with --no-verify if you know why you are skipping this."
  exit 1
fi
